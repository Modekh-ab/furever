{
  "schemaVersion": 1,
  "id": "furever",
  "version": "${version}",
  "name": "Furever",
  "description": "A frame-animated running fox for Minecraft menus and loading screens.",
  "authors": ["Mondless"],
  "license": "All Rights Reserved",
  "icon": "assets/furever/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["net.mondless.furever.FureverClient"],
    "modmenu": ["net.mondless.furever.compat.FureverModMenu"]
  },
  "mixins": ["furever.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
